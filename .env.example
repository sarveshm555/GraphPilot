# GraphPilot Environment Configuration Example
# Copy this file to .env and configure your variables

# FalkorDB Connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=graphpilot

# AI / LLM Configuration
# LLM_PROVIDER options:
#  - "mock": Built-in deterministic offline mode. Requires no API keys.
#            Dynamically resolves entities against FalkorDB and executes parameterized tools.
#  - "openai": Uses official OpenAI SDK for bounded multi-step tool calling.
#              Reads OPENAI_API_KEY (or LLM_API_KEY) and OPENAI_MODEL (default: gpt-4o-mini).
#  - "gemini": Can connect via Gemini's OpenAI-compatible endpoint using OPENAI_API_BASE.
LLM_PROVIDER=mock
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=30.0
# Backward-compatible aliases:
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
OPENAI_API_BASE=

# Examples for OpenAI-compatible providers:
# OpenAI Direct:
#   LLM_PROVIDER=openai
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-proj-...
#
# Google Gemini (OpenAI Compatibility Mode):
#   LLM_PROVIDER=openai
#   LLM_MODEL=gemini-1.5-flash
#   OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=AIzaSy...
#
# Local Ollama:
#   LLM_PROVIDER=openai
#   LLM_MODEL=llama3.1
#   OPENAI_API_BASE=http://localhost:11434/v1
#   LLM_API_KEY=ollama

# Application Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
